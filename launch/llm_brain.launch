<launch>
  <!-- Path to the menu configuration database -->
  <arg name="menu_path" default="" doc="Override path to menu.json database (leave empty to auto-resolve)" />

  <!-- LLM Brain ROS Node -->
  <node name="llm_brain_node" pkg="smart_cafeteria" type="llm_brain_node.py" output="screen">
    
    <!-- Load credentials dynamically from system environment variables at startup -->
    <param name="azure_endpoint" value="$(optenv AZURE_OPENAI_ENDPOINT)" />
    <param name="azure_key" value="$(optenv AZURE_OPENAI_API_KEY)" />
    <param name="azure_model" value="$(optenv AZURE_OPENAI_MODEL)" />
    <param name="menu_path" value="$(arg menu_path)" />
  </node>
</launch>
