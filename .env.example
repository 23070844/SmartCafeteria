# Microsoft Azure OpenAI API Configuration
# Copy this file to '.env' and fill in your credentials

# 1. Base URL compatibility endpoint
# For Azure OpenAI, this is usually: https://<resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=https://ronotic-resource.openai.azure.com/openai/v1/

# 2. API key 
AZURE_OPENAI_API_KEY=your_actual_azure_openai_api_key_here

# 3. Model/Deployment Name (e.g. gpt-oss-120b)
AZURE_OPENAI_MODEL=gpt-oss-120b
